# TapeJudge environment. Copy to `.env` and fill in; never commit `.env`.
#
#   cp .env.example .env
#   python3 -c "import secrets; print(secrets.token_hex(32))"   # for the secret

# --- required in production ---------------------------------------------------
# Signs the flash/session cookie. A 32+ byte random value. The app refuses to
# start without it when not in testing/debug mode.
TAPEJUDGE_SECRET=

# Path to the SQLite database (the store of inputs). On a platform, point this at
# a persistent volume, e.g. /data/tapejudge.db.
TAPEJUDGE_DB=/var/lib/tapejudge/tapejudge.db

# --- durable shared store (optional) ------------------------------------------
# A PostgreSQL DSN. When set, the app uses the durable, shared Postgres store
# instead of the SQLite file — the option for a serverless host with no
# persistent filesystem. When unset, SQLite is used. The driver (psycopg) ships
# with the package; `pip install -e '.[server]'` is accepted as a legacy alias.
# TAPEJUDGE_DATABASE_URL=postgresql://user:pass@host:5432/dbname

# The Postgres schema the store uses. REQUIRED on a serverless host (Vercel): a
# function builds a new store per request, so a stable schema is what makes the
# data persist across invocations. Unset elsewhere: the schema is then derived
# from TAPEJUDGE_DB (a file path) or is random for an in-memory store.
# TAPEJUDGE_DB_SCHEMA=tapejudge-prod

# Bind address. 127.0.0.1 behind a reverse proxy; 0.0.0.0 inside a container.
TAPEJUDGE_HOST=127.0.0.1
TAPEJUDGE_PORT=8080

# Send HSTS. Enable ONLY when the app serves its own domain over TLS: the header
# pins the whole host (and subdomains) to HTTPS for a year. It is deliberately
# off by default so a shared work-host domain is never pinned.
# TAPEJUDGE_ENABLE_HSTS=1

# Gunicorn worker count. SQLite is a single-writer store, so the honest default
# is 1. Raise this only after moving to a shared store.
TAPEJUDGE_WORKERS=1

# --- X Layer ------------------------------------------------------------------
# The read-only X Layer RPC endpoint is fixed in code (tapejudge/chain.py,
# https://rpc.xlayer.tech). There is no runtime override; chain reads are
# best-effort and degrade to an honest "unknown" state if the RPC is unreachable.

# --- development only — never set these in production -------------------------
# Allow a fixed, obviously-fake session secret (local demo only).
# TAPEJUDGE_ALLOW_DEV_SECRET=1
# Send the session cookie over plain http (local demo only).
# TAPEJUDGE_INSECURE_COOKIES=1
# Disable the in-process rate limiter (local demo only).
# TAPEJUDGE_DISABLE_RATELIMIT=1

# --- test-only gates ----------------------------------------------------------
# Set TAPEJUDGE_SKIP_CHAIN=1 to skip the live, read-only chain tests offline.
# TAPEJUDGE_SKIP_CHAIN=1

# An ISOLATED Postgres DSN for the store contract test (tests/test_store_contract.py).
# The Postgres half of that contract runs only when this is set; the SQLite half
# always runs. It must point at a throwaway database — each test builds its own
# random `c_<hex>` schema and drops nothing else. This is deliberately a DIFFERENT
# variable from TAPEJUDGE_DATABASE_URL: create_app(testing=True) refuses to start
# whenever any hosted-DB indicator is present (see docs/ARCHITECTURE.md,
# "Test database isolation"), so the contract test never routes through it.
# TAPEJUDGE_TEST_DATABASE_URL=postgresql://user:pass@host:5432/throwaway
